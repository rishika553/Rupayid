# Application
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL on Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=7d
OTP_PEPPER=your-otp-pepper
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Digimiles (SMS)
DIGIMILES_USERNAME=
DIGIMILES_PASSWORD=
DIGIMILES_BASE_URL=https://sms.digimiles.in/bulksms/bulksms
DIGIMILES_SENDER_ID=
DIGIMILES_ENTITY_ID=
DIGIMILES_OTP_MESSAGE=Your RupayAid OTP is {{otp}}. Do not share it with anyone. - RupayAid
DIGIMILES_TEMPLATE_OTP=
DIGIMILES_TEMPLATE_KYC_APPROVED=
DIGIMILES_TEMPLATE_KYC_REJECTED=
DIGIMILES_TEMPLATE_LOAN_APPROVED=
DIGIMILES_TEMPLATE_DISBURSEMENT=
DIGIMILES_TEMPLATE_REPAYMENT_DUE=
DIGIMILES_TEMPLATE_REPAYMENT_SUCCESSFUL=
DIGIMILES_TEMPLATE_PAYMENT_FAILED=

# Redis (optional — used for rate limiting)
REDIS_URL=redis://default:password@host:6379
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudflare R2 (document storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Razorpay (use rzp_test_ keys for development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Sentry (optional)
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Better Stack (optional)
BETTER_STACK_SOURCE_KEY=your-better-stack-key

# BullMQ
BULLMQ_QUEUE_PREFIX=rupayaid

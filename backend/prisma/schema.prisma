// RupayAid Database Schema
// -------------------------------------------------
// Conventions:
//  * UUID primary keys everywhere.
//  * All money uses Decimal (never Float).
//  * Financial records (Ledger, LedgerEntry, PaymentTransaction) are
//    append-only and protected by DB triggers (see migrations).
//  * No raw OTP values, passwords, MFA secrets, or provider API keys
//    are ever stored in plaintext. Only hashes are persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


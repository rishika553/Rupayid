{
  "expo": {
    "name": "RupayAid",
    "slug": "rupayaid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rupayaid",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0866D9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0866D9"
      },
      "package": "com.rupayaid.app",
      "usesCleartextTraffic": true,
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "rupayaid",
              "host": "*"
            },
            {
              "scheme": "https",
              "host": "*.rupayaid.com",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0866D9",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "tsconfigPaths": false,
      "typedRoutes": true
    }
  }
}
